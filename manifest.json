{
  "manifest_version": 3,
  "name": "GMGN FOMO Helper",
  "version": "0.53.22",
  "key": "",
  "description": "Trading tools for GMGN.ai: highlighted developers, native FOMO Following activity, and position alerts.",
  "homepage_url": "https://github.com/d3wlt/gmgn-fomo-helper",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://gmgn.ai/*",
    "https://prod-api.fomo.family/*",
    "https://fomo.family/*",
    "https://*.fomo.family/*",
    "https://bsc-dataseed.bnbchain.org/*",
    "https://bsc-dataseed1.defibit.io/*",
    "https://bsc-dataseed1.ninicoin.io/*"
  ],
  "action": {
    "default_title": "GMGN FOMO Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*"
      ],
      "js": [
        "page-bridge.js",
        "native-quickbuy.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gmgn.ai/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "fomo-passive.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "fomo-passive-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://fomo.family/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
